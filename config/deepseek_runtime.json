{
  "schema_version": "1.0",
  "provider": "deepseek",
  "origin": "https://api.deepseek.com",
  "chat_path": "/chat/completions",
  "models_path": "/models",
  "development_phase": "autonomous_development",
  "decision_policy": "automatic_development",
  "default_execution_mode": "test",
  "default_data_mode": "synthetic_demo",
  "allowed_models": [
    "deepseek-v4-flash",
    "deepseek-v4-pro",
    "deepseek-v4-flash-vision-exp"
  ],
  "routes": {
    "demand_analyst": {"model": "deepseek-v4-flash", "capability": "text"},
    "crop_scientist": {"model": "deepseek-v4-pro", "capability": "text"},
    "supply_weather_scout": {"model": "deepseek-v4-flash", "capability": "text"},
    "resources_margin_analyst": {"model": "deepseek-v4-flash", "capability": "text"},
    "planning_chair": {"model": "deepseek-v4-pro", "capability": "text"},
    "independent_critic": {"model": "deepseek-v4-pro", "capability": "text"},
    "evidence_extractor": {"model": "deepseek-v4-flash", "capability": "text"},
    "crop_alias_resolver": {"model": "deepseek-v4-flash", "capability": "text"},
    "runtime_researcher": {"model": "deepseek-v4-pro", "capability": "text"},
    "visual_observer": {"model": "deepseek-v4-flash-vision-exp", "capability": "vision"},
    "document_vision": {"model": "deepseek-v4-flash-vision-exp", "capability": "vision"},
    "satellite_visual_reviewer": {"model": "deepseek-v4-flash-vision-exp", "capability": "vision"},
    "test_evaluator": {"model": "deepseek-v4-pro", "capability": "text"}
  },
  "limits": {
    "max_requests": 16,
    "max_reserved_output_tokens": 16384,
    "max_wall_seconds": 300,
    "max_concurrency": 1,
    "max_images_per_request": 4,
    "max_image_bytes": 4194304,
    "max_image_dimension": 4096,
    "max_request_bytes": 16777216,
    "max_response_bytes": 4194304,
    "connect_timeout_seconds": 10,
    "read_timeout_seconds": 90,
    "write_timeout_seconds": 30,
    "pool_timeout_seconds": 5
  }
}
